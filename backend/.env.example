# Server Configuration

NODE_ENV=development
SERVER_HOST=localhost

# Running project locally
# # Database Configuration for LOCAL
# SERVER_PORT=8080
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=futsal-db
DB_PORT=3306

# Secret keys for JWT
JWT_SECRET_USER=usersecretkey
JWT_SECRET_FUTSAL=footsalsecretkey
JWT_SECRET_ADMIN=adminsecretkey

# Token Expiration Times
TOKEN_EXPIRATION_USER=30d
TOKEN_EXPIRATION_FUTSAL=30d
TOKEN_EXPIRATION_ADMIN=30d

# USER CONFIG
USER_FRONTEND_URL=http://localhost:3001
USER_DEFAULT_ROLE=user
USER_PASSWORD_SALT_ROUNDS=8

# FOOTSAL OWNER CONFIG
FOOTSAL_FRONTEND_URL=http://localhost:3002
FOOTSAL_DEFAULT_ROLE=footsal
FOOTSAL_PASSWORD_SALT_ROUNDS=8

#Admin Config
ADMIN_FRONTEND_URL=http://localhost:3003
ADMIN_DEFAULT_ROLE=admin
ADMIN_PASSWORD_SALT_ROUNDS=8

# Reddis Configuration
REDIS_HOST=redis-18366.crce276.ap-south-1-3.ec2.cloud.redislabs.com
REDIS_PORT=18366
REDIS_USERNAME=default
REDIS_PASSWORD=FFinhDsH0rrAKMdrDwAp1TSVo5gvNgGO
REDIS_URL=redis://default:FFinhDsH0rrAKMdrDwAp1TSVo5gvNgGO@redis-18366.crce276.ap-south-1-3.ec2.cloud.redislabs.com:18366
REDIS_CACHE_TTL_SECONDS=3600
LOCAL_REDIS_URL=redis://127.0.0.1:6379

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_SIZE=10485760
LOG_MAX_FILES=5
LOG_JSON_FORMAT=false
LOG_CONSOLE_OUTPUT=true
LOG_TIMESTAMP_FORMAT=YYYY-MM-DD HH:mm:ss

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_MESSAGE=Too many requests from this IP, please try again later.
RATE_LIMIT_ENABLE=true

# Session Configuration
SESSION_SECRET=sessionsecretkey
SESSION_COOKIE_MAX_AGE=86400000
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=false
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY_COOKIE=true

# Email Configuration GOOGLE EMAIL SMTP
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_HOST_USERNAME=
EMAIL_HOST_PASSWORD=
EMAIL_DEFAULT_FROM=


# File Upload Configuration
FILE_UPLOAD_MAX_SIZE=
FILE_UPLOAD_ALLOWED_TYPES=
FILE_UPLOAD_STORAGE_PATH=
FILE_UPLOAD_USE_CLOUD_STORAGE=


# CAPTCHA Configuration
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Third-Party API Keys
GOOGLE_MAPS_API_KEY=
PAYMENT_GATEWAY_API_KEY=
